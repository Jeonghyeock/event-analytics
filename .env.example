# 앱(서버)이 접속하는 role(DML만). 만드는 법은 README.
DATABASE_URL=postgres://event_analytics_app:비밀번호@127.0.0.1:5432/event_analytics
# 마이그레이션과 테스트 준비가 접속하는 소유자 role(표의 주인, 테스트 DB 복제를 위해 CREATEDB).
DATABASE_OWNER_URL=postgres://event_analytics:비밀번호@127.0.0.1:5432/event_analytics
# 수집 API(POST /ingest)의 쓰기 키. 32자 이상의 무작위 글자로 채운다(없으면 서버가 뜨지 않는다).
INGEST_WRITE_KEY=
# PORT=3002
