{
  "name": "@event-analytics/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "db:maintain": "tsx --env-file-if-exists=../../.env src/db/maintain-cli.ts",
    "rollup:run": "tsx --env-file-if-exists=../../.env src/rollup-cli.ts",
    "test": "vitest run",
    "load:generate": "tsx --env-file-if-exists=../../.env src/load/generate-cli.ts",
    "load:detach-rehearsal": "tsx --env-file-if-exists=../../.env src/load/detach-rehearsal-cli.ts",
    "load:report-bench": "tsx --env-file-if-exists=../../.env src/load/report-bench-cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@event-analytics/shared": "*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
